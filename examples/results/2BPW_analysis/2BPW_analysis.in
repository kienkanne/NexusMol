parm /localscratch/kbui/NexusMol/build/md_test_data/2BPW.prmtop
trajin /localscratch/kbui/NexusMol/build/md_test_data/2BPW_seed0.nc

autoimage


# --- RMS analysis ---
rmsd first :1-198@CA out rmsd_2BPW_analysis.out
atomicfluct out rmsf_bb_2BPW_analysis.dat @CA,C,N byres

run

# --- Hydrogen bonds analysis ---
# Protein–Protein hydrogen bonds
hbond ProtProt :1-198 out PP_hbvtime_2BPW_analysis.dat avgout PP_avg_2BPW_analysis.dat

# Protein–Water hydrogen bonds
hbond All :1-198 solventdonor :WAT solventacceptor :WAT@O out All_hbvtime_2BPW_analysis.dat solvout PW_avg_2BPW_analysis.dat bridgeout Bridge_avg_2BPW_analysis.dat

### Only strip out solvent after protein-water analysis
strip :Na+,Cl-,WAT

# Backbone-only protein hydrogen bonds
hbond BB_Prot :1-198@C,O,N,H avgout BB_avg_2BPW_analysis.dat series uuseries BB_series_2BPW_analysis.dat

# Protein–Ligand hydrogen bonds
### Remaining mask is the ligand
hbond ProtLig_PL \
    donormask :1-198 \
    acceptormask !(:1-198) \
    avgout PL_avg.dat

hbond ProtLig_LP \
    donormask !(:1-198) \
    acceptormask :1-198 \
    avgout LP_avg.dat

run

# Create time-series counts
create PW_hbvtime_2BPW_analysis.dat All[UV]
create Bridge_hbvtime_2BPW_analysis.dat All[Bridge]
create BB_hbvtime_2BPW_analysis.dat BB_Prot[UU]

ProtLig_All = ProtLig_PL[UU] + ProtLig_LP[UU]
create PL_hbvtime_2BPW_analysis.dat ProtLig_All

run

# --- Secondary structure analysis ---
secstruct out ss_per_res_2BPW_analysis.dat sumout summary_ss_2BPW_analysis.dat totalout total_2BPW_analysis.out
run

# --- PCA analysis ---
average @N,C,CA crdset trajaverage
createcrd trajectory
run

crdaction trajectory rms ref trajaverage @N,C,CA
crdaction trajectory matrix covar name covmatrix @N,C,CA
runanalysis diagmatrix covmatrix out evecs_2BPW_analysis.dat vecs 10 name eigenvectors \
nmwiz nmwizvecs 10 nmwizfile normalmodes.nmd nmwizmask @N,C,CA

crdaction trajectory projection modes eigenvectors beg 1 end 10 \
@N,C,CA out pca_2BPW_analysis.dat

run

# --- Clustering ---
cluster c1 \
 kmeans clusters 5 randompoint maxit 500 \
 rms :1-198@C,N,O,CA,CB \
 sieve 10 random \
 out cnumvtime_2BPW_analysis.dat \
 summary summary_2BPW_analysis.dat \
 info info_2BPW_analysis.dat \
 cpopvtime cpopvtime_2BPW_analysis.agr normframe \
 repout rep_2BPW_analysis repfmt pdb \
 singlerepout singlerep_2BPW_analysis.nc singlerepfmt netcdf \
 avgout avg_2BPW_analysis avgfmt pdb

run

quit